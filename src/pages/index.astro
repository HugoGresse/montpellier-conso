---
import dataset from '../data/comptes.json'
import Base from '../layouts/Base.astro'
import { formatEuros } from '../lib/format'
import { buildMetricView } from '../lib/metric-view'
import type { Dataset } from '../lib/types'
import { METRICS, UPCOMING_METRICS } from '../metrics'

const base = import.meta.env.BASE_URL
const cards = METRICS.map((metric) => {
  const { rows } = buildMetricView(metric, dataset as Dataset)
  return { metric, latest: rows.at(-1) }
})
---

<Base
  title="Montpellier, la mairie au compteur"
  description="Ce que consomme et dépense la Ville de Montpellier, à partir de ses comptes publiés en open data."
>
  <h1>Ce que consomme la mairie de Montpellier</h1>
  <p class="lede">
    La Ville publie chaque année ses comptes en open data. Ce site en extrait les dépenses de
    consommation (eau pour commencer) et les rend lisibles, année par année, avec les sources et la
    méthode.
  </p>

  <div class="grid">
    {
      cards.map(({ metric, latest }) => (
        <a class="card metric" href={`${base}${metric.slug}/`}>
          <span class="name">{metric.shortTitle}</span>
          {latest && (
            <span class="value">
              {formatEuros(latest.total)} <small>en {latest.year}</small>
            </span>
          )}
          <span class="summary">{metric.summary}</span>
        </a>
      ))
    }
    {
      UPCOMING_METRICS.map((metric) => (
        <div class="card metric upcoming" aria-disabled="true">
          <span class="name">{metric.title}</span>
          <span class="summary">À venir · compte {metric.nature}</span>
        </div>
      ))
    }
  </div>

  <h2>Méthode</h2>
  <p>
    Les montants viennent des comptes administratifs de la Ville (2005-2024) et de son compte
    financier unique (2025), publiés sur data.montpellier3m.fr. Chaque total annuel est vérifié
    contre les balances comptables de la DGFiP. Le code et les données extraites sont publics.
  </p>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }

  a.metric:hover {
    border-color: var(--accent);
  }

  .name {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .value {
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .value small {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .summary {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .upcoming {
    opacity: 0.6;
    border-style: dashed;
  }
</style>
