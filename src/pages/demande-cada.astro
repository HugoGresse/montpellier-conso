---
import { Content } from '../../docs/demande-cada.md'
import Base from '../layouts/Base.astro'
---

<Base
  title="Demande CADA · Montpellier, la mairie au compteur"
  description="Modèle de demande d'accès aux documents administratifs sur la consommation d'eau de la Ville de Montpellier."
>
  <article class="prose">
    <Content />
  </article>
</Base>

<style>
  .prose {
    max-width: 46rem;
  }

  .prose :global(h1) {
    margin-top: 0.5rem;
  }

  .prose :global(blockquote) {
    margin: 1rem 0;
    padding: 1rem 1.25rem;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 8px;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
</style>
