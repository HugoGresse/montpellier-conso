---
import type { YearRow } from '../lib/aggregate'
import type { Series } from '../lib/chart'
import { formatEuros } from '../lib/format'

interface Props {
  rows: YearRow[]
  series: Series[]
}

const { rows, series } = Astro.props
const cell = (row: YearRow, id: string) => {
  const value = row.byGroup[id]
  return value ? formatEuros(value) : '–'
}
const controlStatus = (row: YearRow) => {
  if (row.source === 'dgfip') return 'Source DGFiP'
  if (row.control === undefined) return 'Non disponible'
  return Math.abs(row.control - row.total) < 0.01 ? 'Identique' : formatEuros(row.control)
}
---

<details class="card table-card" data-year-table>
  <summary>Voir les données en tableau</summary>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Année</th>
          {series.map((s) => (
            <th scope="col" data-group={s.id}>
              {s.label}
            </th>
          ))}
          <th scope="col" data-total-header>
            Total
          </th>
          <th scope="col">Contrôle DGFiP</th>
        </tr>
      </thead>
      <tbody>
        {
          [...rows].reverse().map((row) => (
            <tr>
              <th scope="row">{row.year}</th>
              {series.map((s) => (
                <td data-group={s.id} data-value={row.byGroup[s.id] ?? 0}>
                  {cell(row, s.id)}
                </td>
              ))}
              <td class="total" data-row-total>
                {formatEuros(row.total)}
              </td>
              <td class="control">{controlStatus(row)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</details>

<script>
  import { formatEuros } from '../lib/format'

  document.addEventListener('chart:selection', (event) => {
    const selected = new Set((event as CustomEvent<string[]>).detail)
    for (const table of document.querySelectorAll<HTMLElement>('[data-year-table]')) {
      const groups = new Set(
        [...table.querySelectorAll<HTMLElement>('th[data-group]')].map((th) => th.dataset.group),
      )
      const all = [...groups].every((id) => id && selected.has(id))
      for (const cell of table.querySelectorAll<HTMLElement>('[data-group]')) {
        cell.hidden = !selected.has(cell.dataset.group ?? '')
      }
      for (const row of table.querySelectorAll('tbody tr')) {
        const total = [...row.querySelectorAll<HTMLElement>('td[data-group]')]
          .filter((cell) => !cell.hidden)
          .reduce((sum, cell) => sum + Number(cell.dataset.value ?? 0), 0)
        const totalCell = row.querySelector<HTMLElement>('[data-row-total]')
        if (totalCell) totalCell.textContent = formatEuros(total)
      }
      const header = table.querySelector<HTMLElement>('[data-total-header]')
      if (header) header.textContent = all ? 'Total' : 'Total (sélection)'
    }
  })
</script>

<style>
  .table-card {
    margin-top: 1rem;
    padding: 0;
  }

  summary {
    cursor: pointer;
    padding: 0.9rem 1.25rem;
    font-weight: 600;
  }

  .scroll {
    overflow-x: auto;
    padding: 0 1.25rem 1.25rem;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border);
    text-align: right;
    white-space: nowrap;
  }

  thead th {
    color: var(--text-secondary);
    font-weight: 600;
    white-space: normal;
    vertical-align: bottom;
    min-width: 6.5rem;
  }

  th:first-child {
    text-align: left;
    min-width: 0;
  }

  .total {
    font-weight: 600;
  }

  .control {
    color: var(--text-muted);
  }
</style>
