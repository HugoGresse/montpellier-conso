---
import type { YearRow } from '../lib/aggregate'
import type { Series } from '../lib/chart'
import { renderChartSvg } from '../lib/chart-svg'

interface Props {
  rows: YearRow[]
  series: Series[]
  caption: string
}

const { rows, series, caption } = Astro.props
const allSelected = new Set(series.map((s) => s.id))
const payload = JSON.stringify({ rows, series, caption })
---

<div class="explorer" data-chart={payload}>
  <div class="filters" role="group" aria-label="Services affichés">
    <span class="filters-label">Services</span>
    {
      [...series].reverse().map((s) => (
        <button type="button" class="chip" aria-pressed="true" data-series={s.id}>
          <span class:list={['swatch', { hatched: s.hatched }]} style={`--swatch: ${s.color}`} />
          {s.label}
        </button>
      ))
    }
    <button type="button" class="reset" data-reset hidden>Tout afficher</button>
  </div>
  <p class="filters-hint">Clic : afficher ou masquer un service. Double-clic : ne garder que lui.</p>

  <figure class="chart card">
    <figcaption class="caption">
      {caption}
      <span class="selection-total" aria-live="polite"></span>
    </figcaption>
    <div class="plot">
      <Fragment set:html={renderChartSvg(rows, series, allSelected, caption)} />
      <div class="tooltip" role="status" hidden></div>
    </div>
  </figure>
</div>

<script>
  import type { YearRow } from '../lib/aggregate'
  import type { Series } from '../lib/chart'
  import {
    parseSelection,
    renderChartSvg,
    selectRows,
    serializeSelection,
    toggleSelection,
  } from '../lib/chart-svg'
  import { formatEuros } from '../lib/format'

  interface Payload {
    rows: YearRow[]
    series: Series[]
    caption: string
  }

  const QUERY_KEY = 'services'

  function buildTooltip(row: YearRow, series: Series[]): DocumentFragment {
    const fragment = document.createDocumentFragment()
    const total = document.createElement('strong')
    total.className = 'tt-total'
    total.textContent = formatEuros(row.total)
    const year = document.createElement('span')
    year.className = 'tt-year'
    year.textContent = String(row.year)
    const list = document.createElement('ul')
    for (const s of [...series].reverse()) {
      const value = row.byGroup[s.id]
      if (!value) continue
      const item = document.createElement('li')
      const key = document.createElement('span')
      key.className = 'tt-key'
      key.style.background = s.color
      const amount = document.createElement('span')
      amount.className = 'tt-value'
      amount.textContent = formatEuros(value)
      const label = document.createElement('span')
      label.className = 'tt-label'
      label.textContent = s.label
      item.append(key, amount, label)
      list.append(item)
    }
    fragment.append(total, year, list)
    if (row.source === 'dgfip') {
      const note = document.createElement('small')
      note.textContent = 'Total DGFiP, non ventilé'
      fragment.append(note)
    }
    return fragment
  }

  function mount(root: HTMLElement) {
    const { rows, series, caption } = JSON.parse(root.dataset.chart ?? '{}') as Payload
    const plot = root.querySelector<HTMLElement>('.plot')
    const tooltip = root.querySelector<HTMLElement>('.tooltip')
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')
    const totalLabel = root.querySelector<HTMLElement>('.selection-total')
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-series]')]
    if (!plot || !tooltip || !reset || !totalLabel) return

    const url = new URL(window.location.href)
    let selected: ReadonlySet<string> = parseSelection(url.searchParams.get(QUERY_KEY), series)
    let visibleRows = selectRows(rows, selected)

    const hideTooltip = () => {
      tooltip.hidden = true
      plot.querySelectorAll('.bar.active').forEach((bar) => bar.classList.remove('active'))
    }

    const showTooltip = (hit: Element) => {
      const row = visibleRows[Number((hit as HTMLElement).dataset.index)]
      if (!row) return
      plot.querySelectorAll('.bar.active').forEach((bar) => bar.classList.remove('active'))
      hit.closest('.bar')?.classList.add('active')
      tooltip.replaceChildren(buildTooltip(row, series))
      tooltip.hidden = false
      const target = hit.getBoundingClientRect()
      const box = plot.getBoundingClientRect()
      const center = target.left - box.left + plot.scrollLeft + target.width / 2
      const fitsRight = center + tooltip.offsetWidth + 12 < plot.scrollLeft + box.width
      tooltip.style.left = `${fitsRight ? center + 12 : center - tooltip.offsetWidth - 12}px`
      tooltip.style.top = '8px'
    }

    const bindHits = () => {
      for (const hit of plot.querySelectorAll('.hit')) {
        hit.addEventListener('pointerenter', () => showTooltip(hit))
        hit.addEventListener('focus', () => showTooltip(hit))
        hit.addEventListener('blur', hideTooltip)
      }
    }

    const render = () => {
      visibleRows = selectRows(rows, selected)
      hideTooltip()
      plot.querySelector('svg')?.remove()
      plot.insertAdjacentHTML('afterbegin', renderChartSvg(rows, series, selected, caption))
      bindHits()

      const all = selected.size === series.length
      reset.hidden = all
      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(selected.has(chip.dataset.series ?? '')))
      }
      totalLabel.textContent = all ? '' : ' (sélection)'

      const query = serializeSelection(selected, series)
      if (query) url.searchParams.set(QUERY_KEY, query)
      else url.searchParams.delete(QUERY_KEY)
      history.replaceState(null, '', url)
    }

    const announce = () =>
      document.dispatchEvent(new CustomEvent('chart:selection', { detail: [...selected] }))

    const update = () => {
      render()
      announce()
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        selected = toggleSelection(selected, chip.dataset.series ?? '')
        update()
      })
      chip.addEventListener('dblclick', () => {
        selected = new Set([chip.dataset.series ?? ''])
        update()
      })
    }
    reset.addEventListener('click', () => {
      selected = new Set(series.map((s) => s.id))
      update()
    })
    plot.addEventListener('pointerleave', hideTooltip)

    if (selected.size === series.length) {
      bindHits()
      return
    }
    render()
    if (document.readyState === 'complete') announce()
    else window.addEventListener('load', announce, { once: true })
  }

  document.querySelectorAll<HTMLElement>('[data-chart]').forEach(mount)
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .filters-hint {
    margin: -0.35rem 0 0.75rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .filters-label {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-right: 0.25rem;
  }

  .chip,
  .reset {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-1);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .chip[aria-pressed='false'] {
    color: var(--text-muted);
    background: transparent;
    border-style: dashed;
  }

  .chip[aria-pressed='false'] .swatch {
    background: transparent;
    outline: 1.5px solid var(--swatch);
    outline-offset: -1.5px;
  }

  .chip:hover,
  .reset:hover {
    border-color: var(--text-muted);
  }

  .chip:focus-visible,
  .reset:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .reset {
    border-color: transparent;
    color: var(--accent);
    background: transparent;
  }

  .reset[hidden] {
    display: none;
  }

  .swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 3px;
    background: var(--swatch);
    flex: none;
  }

  .swatch.hatched {
    background: repeating-linear-gradient(
      45deg,
      var(--series-neutral) 0 3px,
      var(--surface-1) 3px 6px
    );
    outline: 1px solid var(--series-neutral);
  }

  .chart {
    margin: 0;
  }

  .caption {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .selection-total {
    color: var(--text-muted);
    font-weight: 400;
  }

  .plot {
    position: relative;
    overflow-x: auto;
  }

  .plot :global(svg) {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
    font-size: 13px;
  }

  .plot :global(.tick line) {
    stroke: var(--grid);
  }

  .plot :global(:is(.tick text, .year)) {
    fill: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .plot :global(.baseline) {
    stroke: var(--text-muted);
  }

  .plot :global(.direct-label) {
    fill: var(--text-primary);
    font-weight: 600;
  }

  .plot :global(.hit) {
    fill: transparent;
    cursor: pointer;
    outline: none;
  }

  .plot :global(.hit:focus-visible) {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .plot :global(.bar :is(path, rect:not(.hit))) {
    transition: opacity 120ms;
  }

  .plot:has(:global(.bar.active)) :global(.bar:not(.active) :is(path, rect:not(.hit))) {
    opacity: 0.45;
  }

  .tooltip {
    position: absolute;
    z-index: 1;
    min-width: 13rem;
    max-width: 18rem;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    background: var(--tooltip-bg);
    color: var(--tooltip-text);
    font-size: 0.8125rem;
    pointer-events: none;
  }

  .tooltip :global(.tt-total) {
    display: block;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
  }

  .tooltip :global(.tt-year) {
    display: block;
    opacity: 0.75;
    margin-bottom: 0.35rem;
  }

  .tooltip :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tooltip :global(li) {
    display: grid;
    grid-template-columns: 0.75rem auto 1fr;
    gap: 0.45rem;
    align-items: center;
  }

  .tooltip :global(.tt-key) {
    height: 2px;
    border-radius: 1px;
  }

  .tooltip :global(.tt-value) {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .tooltip :global(.tt-label) {
    opacity: 0.8;
  }
</style>
